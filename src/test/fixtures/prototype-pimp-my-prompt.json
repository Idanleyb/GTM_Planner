      "market": "English-speaking B2B and B2C marketers (US, UK, Israel tech scene); remote-first teams",
      "audience": "In-house marketers and freelancers (1–10 person teams) who use ChatGPT/Claude/Midjourney daily but have no feedback loop on prompt quality or tool choice.",
      "valueProp": "Paste your goal, tool and prompt — get a scored breakdown and concrete rewrites in 30 seconds, so every AI task produces usable output on the first or second try.",
      "motion": "PLG",
      "budget": 15000,
      "currency": "USD",
      "target": "120 Pro subscribers ($19/mo) ≈ $27K ARR run-rate by Jan 30, 2027",
      "owner": "Idan Leibovitch",
